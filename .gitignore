# Operating-system metadata and editor temporary files.
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~

# Local configuration and temporary verification output.
.env
.env.*
!.env.example
!.env.sample
/.artifacts/
/tmp/
*.log
__pycache__/
*.py[cod]

# Machine-local MCP configuration and reproducible editor tooling.
**/.codex/config.toml
**/.codex/config.toml.envart-backup
**/addons/godot_ai/
**/addons/.godot_ai_update/
**/addons/.godot-ai-stage-*/

# Blender backup files. Keep original .blend files and authored assets tracked.
*.blend[0-9]
*.blend[0-9][0-9]

# Mixamo permits use in games; raw source redistribution is not assumed.
# Recreate these local assets with tools/install_mixamo.py using your own downloads.
/GodotProject/envart-pipline/characters/mixamo_local/
