[node name="Rewind" type="Button" parent="Margin/Rows/Buttons"]
layout_mode = 2
focus_mode = 0
text = "Home  Rewind"

[node name="Loop" type="CheckButton" parent="Margin/Rows/Buttons"]
layout_mode = 2
focus_mode = 0
text = "L  Loop"

[node name="Timeline" type="HBoxContainer" parent="Margin/Rows"]
layout_mode = 2
