[sub_resource type="Shader" id="Shader_85of5"]
code = "shader_type spatial; render_mode cull_disabled; uniform sampler2D soil:source_color,filter_linear_mipmap,repeat_enable; varying vec3 wp; void vertex(){wp=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;} void fragment(){float p=sin(wp.x*.34+sin(wp.z*.29))*sin(wp.z*.39);vec3 tex=texture(soil,wp.xz*.32).rgb; ALBEDO=mix(vec3(.14,.23,.045),vec3(.27,.34,.11),.5+.45*p)*(.55+tex*1.6);ROUGHNESS=.95;}"

